---
// Custom botanical line-art marks per journey (replaces emojis).
// Uses currentColor so the journey accent applies via CSS.
const { journey, size = 52 } = Astro.props;

const marks = {
  // Newcomer, a sprouting seedling (beginnings, growth)
  newcomer: `
    <path d="M24 45V19" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
    <path d="M24 31C24 24 18.5 19 9.5 19 8.5 27 15 31 24 31Z" fill="currentColor" fill-opacity="0.13" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
    <path d="M12.5 22.5C16.5 24 20 27 22.5 31" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
    <path d="M24 25.5C24 18.5 29 14 38 14 39 21 32 25.5 24 25.5Z" fill="currentColor" fill-opacity="0.13" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
    <path d="M35.5 17.5C31.5 18.8 28.5 21.4 26 24.8" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>`,

  // Local Node, a radiating seed-head / hub (network, local nodes connecting)
  'local-node': `
    <path d="M24 45V25" stroke="currentColor" stroke-width="2.1" stroke-linecap="round"/>
    <g stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
      <path d="M24 20V9"/><path d="M24 20 33.5 12"/><path d="M24 20 38 20"/><path d="M24 20 33.5 28.5"/><path d="M24 20 14.5 28.5"/><path d="M24 20 10 20"/><path d="M24 20 14.5 12"/>
    </g>
    <g fill="currentColor">
      <circle cx="24" cy="7.6" r="2"/><circle cx="34.6" cy="11" r="2"/><circle cx="39.2" cy="20" r="2"/><circle cx="34.6" cy="29.5" r="2"/><circle cx="13.4" cy="29.5" r="2"/><circle cx="8.8" cy="20" r="2"/><circle cx="13.4" cy="11" r="2"/>
    </g>
    <circle cx="24" cy="20" r="3.4" fill="currentColor"/>`,

  // Knowledge Commons, an unfurling fern fiddlehead (living, growing knowledge)
  'knowledge-commons': `
    <path d="M23 45C23 33 20 27 25 22 29.4 17.6 24.5 12.5 20.5 15 17 17.2 19 22 23 20.6" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/>
    <g stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
      <path d="M22.6 39C19 38.5 15.5 36 13.5 32"/>
      <path d="M22 33C26 32.6 29.5 30 31.5 26.4"/>
      <path d="M21.6 27.5C18.5 27 15.8 24.8 14.2 21.4"/>
    </g>
    <circle cx="22.4" cy="18.4" r="1.7" fill="currentColor"/>`,
};

const svg = marks[journey] || marks.newcomer;
---
<svg width={size} height={size} viewBox="0 0 48 48" fill="none" aria-hidden="true" class="jmark" set:html={svg}></svg>
