schema: resource
object:
  title: "Citation File Format (CITATION.cff)"
  type: resource
  url: https://citation-file-format.github.io/
  resource_type: standard
  link_status: active
  notes: >-
    Plain-text file dropped in a GitHub repo root; on the default branch
