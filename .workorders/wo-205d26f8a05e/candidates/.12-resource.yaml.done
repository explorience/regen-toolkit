schema: resource
object:
  title: GravityDAO
  type: resource
  resource_type: org
  url: https://gravitydao.org/
  link_status: active
  notes: >-
    A conflict-management and trust-building collective that grew out of the
    Token Engineering Commons to offer dispute resolution for Web3 projects.
    Cited in the article's closing section as a reminder that a commons's
    durability rests on coordination and care as much as on tool substrate —
    "tools preserve knowledge; they do not preserve trust."
  related_concepts:
    - infrastructure-follows-function
  toolkit_route: layer-3-resource-graph
