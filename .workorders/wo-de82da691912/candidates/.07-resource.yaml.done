schema: resource
object:
  title: Near Protocol
  type: resource
  url: https://near.org
  resource_type: layer-1 blockchain, sharded, accessibility-focused
  link_status: active
  notes: >-
    Prioritizes developer experience and user accessibility; uses "Nightshade"
    sharding to process blockchain data in parallel pieces, and leans on
    account abstraction to make wallet experiences feel more familiar to
    non-crypto-native users. Article notes Near has funded carbon removal for
    its own operations and frames its usability focus as aligned with bringing
    web3 to people outside the space already.
  toolkit_route: layer-3-resource-graph
  maturity: raw
  ai_assisted: true
  provenance:
    origin: src/content/docs/other-chains.md
    transformation: summarized
    authorship: ai-assisted
