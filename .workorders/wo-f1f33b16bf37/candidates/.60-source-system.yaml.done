schema: source-system
object:
  title: Agroecología en Puerto Rico Archive
  type: archive
  steward: Agroecología en Puerto Rico Archive
  return_path: unset — establish via register-source
  url: https://www.agroecologiapr.org/
  what_it_curates: >-
    Farm videos; seed-saving demonstrations; farmer stories; markets and links; school agriculture; production
    and processing practices; project and license pages.
  why_it_matters: >-
    Collaborative video and illustration project created by Juan Manuel Pagán Teitelbaum, Mariolga Reyes
    Cruz and Organización Boricuá, documenting farms, seed saving, markets, school gardens and ecological
    practices in Puerto Rico.
