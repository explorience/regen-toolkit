schema: source-system
object:
  title: Global Indigenous Data Alliance (GIDA)
  type: directory
  steward: Global Indigenous Data Alliance (GIDA)
  return_path: unset — establish via register-source
  url: https://www.gida-global.org/
  what_it_curates: >-
    CARE Principles; Indigenous Peoples’ Rights in Data; history and network map; communiqués; IEEE provenance
    work; global and regional data-sovereignty networks; IDSov and AI convenings.
  why_it_matters: >-
    An international Indigenous-led network advancing Indigenous Data Sovereignty and governance, collective
    rights and interests in data, and data for self-determined wellbeing.
  maturity: raw
  ai_assisted: true
  provenance:
    origin: Canonical_DB.xlsx#Source-System Cards!row16
    source_lineage: https://www.gida-global.org/
  caution: >-
    Do not reduce Indigenous data governance to generic privacy, ethics, or open-data compliance. GIDA
    is a network, not a universal representative of all Indigenous Peoples or communities.
