schema: encyclopedia-entry
object:
  title: Governance Mechanism Design
  type: encyclopedia-entry
  page_type: framework
  summary: >-
    A framework for designing DAO/community governance mechanisms: six core
    mechanisms (token-weighted voting, one-person-one-vote, quadratic voting,
    conviction voting, consent-based decision making, futarchy) each with a
    best-fit context and named risks; a decision-type-to-mechanism mapping
    table; five design principles (match mechanism to context, minimize
    complexity, build in safeguards, iterate, transparency); and
    anti-manipulation measures against Sybil attacks, whale dominance, and
    collusion. Recommends starting with consent-based decisions for small
    groups and adding quadratic voting plus delegation as the group grows.
  audience: DAO/community governance designers
  known_tensions: []
  related_concepts:
    - quadratic-voting
    - conviction-voting
  related_resources:
    - gitcoin-passport
    - brightid
  maturity: raw
  ai_assisted: true
  provenance:
    origin: src/content/docs/governance-mechanism-design.md
    transformation: summarized
    authorship: ai-assisted

